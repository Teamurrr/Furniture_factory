<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="Purchase Materials"
            android:textColor="@color/brand_ink"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Register incoming materials with clean calculations and a calmer workspace."
            android:textColor="@color/brand_muted"
            android:textSize="15sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/brand_panel"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <Spinner
                    android:id="@+id/materialSpinner"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_soft"
                    android:padding="10dp"
                    android:popupBackground="@color/brand_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Spinner
                    android:id="@+id/employeeSpinner"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_soft"
                    android:padding="10dp"
                    android:popupBackground="@color/brand_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/quantityEdit"
                    android:hint="Enter quantity"
                    android:textColor="@color/brand_ink"
                    android:textColorHint="@color/brand_muted"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_input_soft"
                    android:layout_marginBottom="16dp"
                    android:inputType="numberDecimal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/priceText"
                    android:text="Price: 0"
                    android:textSize="16sp"
                    android:textColor="@color/brand_muted"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/totalText"
                    android:text="Total: 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_success"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/buyButton"
                    android:text="Buy"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
