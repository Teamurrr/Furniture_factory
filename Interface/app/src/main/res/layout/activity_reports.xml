<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reports"
            android:textColor="@color/brand_ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="Choose the report you want to review in table form."
            android:textColor="@color/brand_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/btnPurchases"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="Purchases Report"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSales"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Sales Report"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnProduction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Production Report"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSalary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Salary Report"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCredits"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Credits Report"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
