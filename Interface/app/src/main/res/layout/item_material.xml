<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    card_view:cardBackgroundColor="@color/brand_panel"
    card_view:cardCornerRadius="22dp"
    card_view:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/materialName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Material Name"
            android:textColor="@color/brand_ink"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/materialQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Quantity"
            android:textColor="@color/brand_muted"/>

        <TextView
            android:id="@+id/materialAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Amount"
            android:textColor="@color/brand_success"/>

        <TextView
            android:id="@+id/materialUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Unit"
            android:textColor="@color/brand_muted"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
